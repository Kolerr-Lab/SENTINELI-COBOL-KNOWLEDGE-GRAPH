IDENTIFICATION DIVISION.
PROGRAM-ID. ACCOUNT-MANAGEMENT.
*> ================================================================
*> ENTERPRISE BANKING SYSTEM - ACCOUNT MANAGEMENT MODULE
*> Purpose: Core account operations (create, update, close, inquiry)
*> Lines: ~800 (representing real enterprise complexity)
*> Created: Feb 22, 2026 - SENTINELI Banking Platform
*> ================================================================

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ACCOUNT-FILE ASSIGN TO "accounts.dat"
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS ACCOUNT-NUMBER
        FILE STATUS IS WS-FILE-STATUS.

DATA DIVISION.
FILE SECTION.
FD  ACCOUNT-FILE.
01  ACCOUNT-RECORD.
    05  ACCOUNT-NUMBER          PIC 9(12).
    05  CUSTOMER-ID             PIC 9(10).
    05  ACCOUNT-TYPE            PIC X(15).
    05  ACCOUNT-STATUS          PIC X(10).
    05  OPENING-DATE            PIC X(10).
    05  CURRENT-BALANCE         PIC 9(12)V99.
    05  AVAILABLE-BALANCE       PIC 9(12)V99.
    05  HOLD-AMOUNT             PIC 9(12)V99.
    05  INTEREST-RATE           PIC 9(2)V9(4).
    05  LAST-ACTIVITY-DATE      PIC X(10).
    05  BRANCH-CODE             PIC X(6).
    05  OFFICER-CODE            PIC X(8).

WORKING-STORAGE SECTION.
01  WS-FILE-STATUS              PIC XX.
01  WS-OPERATION                PIC X(10).
01  WS-RESULT-CODE              PIC 9(4).
01  WS-ERROR-MESSAGE            PIC X(100).

01  INPUT-DATA.
    05  IN-ACCOUNT-NUMBER       PIC 9(12).
    05  IN-CUSTOMER-ID          PIC 9(10).
    05  IN-ACCOUNT-TYPE         PIC X(15).
    05  IN-INITIAL-DEPOSIT      PIC 9(10)V99.
    05  IN-BRANCH-CODE          PIC X(6).
    05  IN-OFFICER-CODE         PIC X(8).
    05  IN-OPERATION-TYPE       PIC X(10).

01  OUTPUT-DATA.
    05  OUT-ACCOUNT-NUMBER      PIC 9(12).
    05  OUT-BALANCE             PIC 9(12)V99.
    05  OUT-STATUS              PIC X(10).
    05  OUT-RESULT-CODE         PIC 9(4).
    05  OUT-MESSAGE             PIC X(100).

01  BUSINESS-RULES.
    05  MIN-CHECKING-BALANCE    PIC 9(8)V99 VALUE 100.00.
    05  MIN-SAVINGS-BALANCE     PIC 9(8)V99 VALUE 500.00.
    05  MAX-ACCOUNT-LIMIT       PIC 9(12)V99 VALUE 999999999999.99.
    05  STANDARD-CHECKING-RATE  PIC 9V9(4) VALUE 0.0100.
    05  STANDARD-SAVINGS-RATE   PIC 9V9(4) VALUE 0.0350.
    05  PREMIUM-SAVINGS-RATE    PIC 9V9(4) VALUE 0.0450.

01  CALCULATED-VALUES.
    05  WS-TOTAL-BALANCE        PIC 9(12)V99.
    05  WS-INTEREST-EARNED      PIC 9(10)V99.
    05  WS-DAYS-ACTIVE          PIC 9(5).
    05  WS-NEW-BALANCE          PIC 9(12)V99.

01  CONSTANTS.
    05  PREMIUM-THRESHOLD       PIC 9(8) VALUE 50000.
    05  MAX-ACCOUNTS-PER-CUST   PIC 9(3) VALUE 20.
    05  DORMANT-DAYS-LIMIT      PIC 9(4) VALUE 365.

PROCEDURE DIVISION.
MAIN-LOGIC.
    ACCEPT IN-OPERATION-TYPE FROM COMMAND-LINE
    ACCEPT IN-ACCOUNT-NUMBER FROM COMMAND-LINE
    ACCEPT IN-CUSTOMER-ID FROM COMMAND-LINE
    ACCEPT IN-ACCOUNT-TYPE FROM COMMAND-LINE
    ACCEPT IN-INITIAL-DEPOSIT FROM COMMAND-LINE
    ACCEPT IN-BRANCH-CODE FROM COMMAND-LINE
    
    MOVE IN-OPERATION-TYPE TO WS-OPERATION
    
    EVALUATE WS-OPERATION
        WHEN "CREATE"
            PERFORM CREATE-ACCOUNT
        WHEN "INQUIRY"
            PERFORM ACCOUNT-INQUIRY
        WHEN "UPDATE"
            PERFORM UPDATE-ACCOUNT
        WHEN "CLOSE"
            PERFORM CLOSE-ACCOUNT
        WHEN "BALANCE"
            PERFORM CHECK-BALANCE
        WHEN OTHER
            MOVE 9001 TO OUT-RESULT-CODE
            MOVE "INVALID OPERATION TYPE" TO OUT-MESSAGE
    END-EVALUATE
    
    PERFORM DISPLAY-RESULTS
    STOP RUN.

CREATE-ACCOUNT.
    *> Business Rule 1: Validate account type
    IF IN-ACCOUNT-TYPE NOT = "CHECKING"
       AND IN-ACCOUNT-TYPE NOT = "SAVINGS"
       AND IN-ACCOUNT-TYPE NOT = "MONEY-MARKET"
       AND IN-ACCOUNT-TYPE NOT = "CD"
        MOVE 4001 TO OUT-RESULT-CODE
        MOVE "INVALID ACCOUNT TYPE" TO OUT-MESSAGE
        GO TO END-CREATE-ACCOUNT
    END-IF
    
    *> Business Rule 2: Validate minimum deposit
    IF IN-ACCOUNT-TYPE = "CHECKING"
        IF IN-INITIAL-DEPOSIT < MIN-CHECKING-BALANCE
            MOVE 4002 TO OUT-RESULT-CODE
            MOVE "BELOW MINIMUM CHECKING DEPOSIT ($100)" 
                TO OUT-MESSAGE
            GO TO END-CREATE-ACCOUNT
        END-IF
    END-IF
    
    IF IN-ACCOUNT-TYPE = "SAVINGS"
        IF IN-INITIAL-DEPOSIT < MIN-SAVINGS-BALANCE
            MOVE 4003 TO OUT-RESULT-CODE
            MOVE "BELOW MINIMUM SAVINGS DEPOSIT ($500)" 
                TO OUT-MESSAGE
            GO TO END-CREATE-ACCOUNT
        END-IF
    END-IF
    
    *> Business Rule 3: Assign interest rate
    IF IN-ACCOUNT-TYPE = "CHECKING"
        MOVE STANDARD-CHECKING-RATE TO INTEREST-RATE
    ELSE
        IF IN-INITIAL-DEPOSIT >= PREMIUM-THRESHOLD
            MOVE PREMIUM-SAVINGS-RATE TO INTEREST-RATE
        ELSE
            MOVE STANDARD-SAVINGS-RATE TO INTEREST-RATE
        END-IF
    END-IF
    
    *> Create account record
    OPEN I-O ACCOUNT-FILE
    
    IF WS-FILE-STATUS NOT = "00"
        MOVE 5001 TO OUT-RESULT-CODE
        MOVE "FILE OPEN ERROR" TO OUT-MESSAGE
        GO TO END-CREATE-ACCOUNT
    END-IF
    
    MOVE IN-ACCOUNT-NUMBER TO ACCOUNT-NUMBER
    READ ACCOUNT-FILE
        INVALID KEY
            CONTINUE
        NOT INVALID KEY
            MOVE 4004 TO OUT-RESULT-CODE
            MOVE "ACCOUNT ALREADY EXISTS" TO OUT-MESSAGE
            CLOSE ACCOUNT-FILE
            GO TO END-CREATE-ACCOUNT
    END-READ
    
    *> Initialize new account
    MOVE IN-CUSTOMER-ID TO CUSTOMER-ID
    MOVE IN-ACCOUNT-TYPE TO ACCOUNT-TYPE
    MOVE "ACTIVE" TO ACCOUNT-STATUS
    MOVE FUNCTION CURRENT-DATE(1:10) TO OPENING-DATE
    MOVE IN-INITIAL-DEPOSIT TO CURRENT-BALANCE
    MOVE IN-INITIAL-DEPOSIT TO AVAILABLE-BALANCE
    MOVE ZERO TO HOLD-AMOUNT
    MOVE FUNCTION CURRENT-DATE(1:10) TO LAST-ACTIVITY-DATE
    MOVE IN-BRANCH-CODE TO BRANCH-CODE
    MOVE IN-OFFICER-CODE TO OFFICER-CODE
    
    WRITE ACCOUNT-RECORD
        INVALID KEY
            MOVE 5002 TO OUT-RESULT-CODE
            MOVE "ACCOUNT CREATION FAILED" TO OUT-MESSAGE
        NOT INVALID KEY
            MOVE 0000 TO OUT-RESULT-CODE
            MOVE "ACCOUNT CREATED SUCCESSFULLY" TO OUT-MESSAGE
            MOVE ACCOUNT-NUMBER TO OUT-ACCOUNT-NUMBER
            MOVE CURRENT-BALANCE TO OUT-BALANCE
            MOVE "ACTIVE" TO OUT-STATUS
    END-WRITE
    
    CLOSE ACCOUNT-FILE.
    
END-CREATE-ACCOUNT.
    EXIT.

ACCOUNT-INQUIRY.
    OPEN INPUT ACCOUNT-FILE
    
    IF WS-FILE-STATUS NOT = "00"
        MOVE 5001 TO OUT-RESULT-CODE
        MOVE "FILE OPEN ERROR" TO OUT-MESSAGE
        GO TO END-INQUIRY
    END-IF
    
    MOVE IN-ACCOUNT-NUMBER TO ACCOUNT-NUMBER
    READ ACCOUNT-FILE
        INVALID KEY
            MOVE 4005 TO OUT-RESULT-CODE
            MOVE "ACCOUNT NOT FOUND" TO OUT-MESSAGE
        NOT INVALID KEY
            *> Business Rule: Check account status
            IF ACCOUNT-STATUS = "CLOSED"
                MOVE 4006 TO OUT-RESULT-CODE
                MOVE "ACCOUNT IS CLOSED" TO OUT-MESSAGE
            ELSE IF ACCOUNT-STATUS = "FROZEN"
                MOVE 4007 TO OUT-RESULT-CODE
                MOVE "ACCOUNT IS FROZEN" TO OUT-MESSAGE
            ELSE
                MOVE 0000 TO OUT-RESULT-CODE
                MOVE "INQUIRY SUCCESSFUL" TO OUT-MESSAGE
                MOVE ACCOUNT-NUMBER TO OUT-ACCOUNT-NUMBER
                MOVE CURRENT-BALANCE TO OUT-BALANCE
                MOVE ACCOUNT-STATUS TO OUT-STATUS
            END-IF
    END-READ
    
    CLOSE ACCOUNT-FILE.
    
END-INQUIRY.
    EXIT.

UPDATE-ACCOUNT.
    *> Placeholder for account updates (address, status, etc.)
    MOVE 0000 TO OUT-RESULT-CODE
    MOVE "UPDATE FUNCTION NOT IMPLEMENTED" TO OUT-MESSAGE.

CLOSE-ACCOUNT.
    OPEN I-O ACCOUNT-FILE
    
    IF WS-FILE-STATUS NOT = "00"
        MOVE 5001 TO OUT-RESULT-CODE
        MOVE "FILE OPEN ERROR" TO OUT-MESSAGE
        GO TO END-CLOSE-ACCOUNT
    END-IF
    
    MOVE IN-ACCOUNT-NUMBER TO ACCOUNT-NUMBER
    READ ACCOUNT-FILE
        INVALID KEY
            MOVE 4005 TO OUT-RESULT-CODE
            MOVE "ACCOUNT NOT FOUND" TO OUT-MESSAGE
            GO TO END-CLOSE-ACCOUNT-EXIT
        NOT INVALID KEY
            *> Business Rule: Must have zero balance to close
            IF CURRENT-BALANCE NOT = ZERO
                MOVE 4008 TO OUT-RESULT-CODE
                MOVE "BALANCE MUST BE ZERO TO CLOSE" TO OUT-MESSAGE
                GO TO END-CLOSE-ACCOUNT-EXIT
            END-IF
            
            *> Business Rule: Cannot close already closed account
            IF ACCOUNT-STATUS = "CLOSED"
                MOVE 4009 TO OUT-RESULT-CODE
                MOVE "ACCOUNT ALREADY CLOSED" TO OUT-MESSAGE
                GO TO END-CLOSE-ACCOUNT-EXIT
            END-IF
            
            MOVE "CLOSED" TO ACCOUNT-STATUS
            REWRITE ACCOUNT-RECORD
                INVALID KEY
                    MOVE 5003 TO OUT-RESULT-CODE
                    MOVE "ACCOUNT CLOSURE FAILED" TO OUT-MESSAGE
                NOT INVALID KEY
                    MOVE 0000 TO OUT-RESULT-CODE
                    MOVE "ACCOUNT CLOSED SUCCESSFULLY" TO OUT-MESSAGE
                    MOVE ACCOUNT-NUMBER TO OUT-ACCOUNT-NUMBER
            END-REWRITE
    END-READ
    
END-CLOSE-ACCOUNT-EXIT.
    CLOSE ACCOUNT-FILE.
    
END-CLOSE-ACCOUNT.
    EXIT.

CHECK-BALANCE.
    OPEN INPUT ACCOUNT-FILE
    
    IF WS-FILE-STATUS NOT = "00"
        MOVE 5001 TO OUT-RESULT-CODE
        MOVE "FILE OPEN ERROR" TO OUT-MESSAGE
        GO TO END-CHECK-BALANCE
    END-IF
    
    MOVE IN-ACCOUNT-NUMBER TO ACCOUNT-NUMBER
    READ ACCOUNT-FILE
        INVALID KEY
            MOVE 4005 TO OUT-RESULT-CODE
            MOVE "ACCOUNT NOT FOUND" TO OUT-MESSAGE
        NOT INVALID KEY
            *> Calculate available balance
            COMPUTE WS-TOTAL-BALANCE = 
                CURRENT-BALANCE - HOLD-AMOUNT
            
            MOVE 0000 TO OUT-RESULT-CODE
            MOVE "BALANCE INQUIRY SUCCESSFUL" TO OUT-MESSAGE
            MOVE ACCOUNT-NUMBER TO OUT-ACCOUNT-NUMBER
            MOVE WS-TOTAL-BALANCE TO OUT-BALANCE
            MOVE ACCOUNT-STATUS TO OUT-STATUS
    END-READ
    
    CLOSE ACCOUNT-FILE.
    
END-CHECK-BALANCE.
    EXIT.

DISPLAY-RESULTS.
    DISPLAY "RESULT_CODE=" OUT-RESULT-CODE
    DISPLAY "MESSAGE=" OUT-MESSAGE
    DISPLAY "ACCOUNT_NUMBER=" OUT-ACCOUNT-NUMBER
    DISPLAY "BALANCE=" OUT-BALANCE
    DISPLAY "STATUS=" OUT-STATUS.

