IDENTIFICATION DIVISION.
PROGRAM-ID. TRANSACTION-PROCESSOR.
*> ================================================================
*> ENTERPRISE BANKING SYSTEM - TRANSACTION PROCESSING MODULE
*> Purpose: Process deposits, withdrawals, transfers, payments
*> Lines: ~1,200 (core transactional engine)
*> Created: Feb 22, 2026 - SENTINELI Banking Platform
*> ================================================================

ENVIRONMENT DIVISION.

DATA DIVISION.
WORKING-STORAGE SECTION.

01  TRANSACTION-INPUT.
    05  TXN-TYPE                PIC X(15).
    05  TXN-ACCOUNT             PIC 9(12).
    05  TXN-AMOUNT              PIC 9(10)V99.
    05  TXN-DEST-ACCOUNT        PIC 9(12).
    05  TXN-REFERENCE           PIC X(20).
    05  TXN-CHANNEL             PIC X(10).

01  TRANSACTION-OUTPUT.
    05  TXN-ID                  PIC 9(18).
    05  TXN-STATUS              PIC X(15).
    05  TXN-RESULT-CODE         PIC 9(4).
    05  TXN-MESSAGE             PIC X(100).
    05  TXN-NEW-BALANCE         PIC 9(12)V99.
    05  TXN-TIMESTAMP           PIC X(26).

01  ACCOUNT-INFO.
    05  ACC-NUMBER              PIC 9(12).
    05  ACC-TYPE                PIC X(15).
    05  ACC-STATUS              PIC X(10).
    05  ACC-BALANCE             PIC 9(12)V99.
    05  ACC-AVAILABLE           PIC 9(12)V99.
    05  ACC-HOLD                PIC 9(12)V99.
    05  ACC-DAILY-LIMIT         PIC 9(8)V99.
    05  ACC-DAILY-USED          PIC 9(8)V99.

01  BUSINESS-RULES.
    05  MAX-DAILY-WITHDRAWAL    PIC 9(8)V99 VALUE 5000.00.
    05  MAX-DAILY-TRANSFER      PIC 9(8)V99 VALUE 10000.00.
    05  MAX-TXN-AMOUNT          PIC 9(10)V99 VALUE 50000.00.
    05  MIN-TXN-AMOUNT          PIC 9(3)V99 VALUE 0.01.
    05  ATM-FEE-EXTERNAL        PIC 9(2)V99 VALUE 3.50.
    05  WIRE-FEE-DOMESTIC       PIC 9(3)V99 VALUE 25.00.
    05  WIRE-FEE-INTERNATIONAL  PIC 9(3)V99 VALUE 45.00.
    05  OVERDRAFT-FEE           PIC 9(3)V99 VALUE 35.00.

01  CALCULATED-VALUES.
    05  WS-FINAL-AMOUNT         PIC 9(10)V99.
    05  WS-FEES-CHARGED         PIC 9(6)V99.
    05  WS-BALANCE-AFTER        PIC S9(12)V99.
    05  WS-DEST-BALANCE         PIC 9(12)V99.

01  TRANSACTION-LIMITS.
    05  DAILY-LIMIT-EXCEEDED    PIC X VALUE 'N'.
    05  FRAUD-SCORE             PIC 9(3)V99.
    05  REQUIRE-APPROVAL        PIC X VALUE 'N'.

01  CONSTANTS.
    05  FRAUD-THRESHOLD         PIC 9(3) VALUE 75.
    05  MAX-CONSECUTIVE-TXN     PIC 9(2) VALUE 10.
    05  VELOCITY-CHECK-MINS     PIC 9(4) VALUE 30.

PROCEDURE DIVISION.
MAIN-LOGIC.
    ACCEPT TXN-TYPE FROM COMMAND-LINE
    ACCEPT TXN-ACCOUNT FROM COMMAND-LINE
    ACCEPT TXN-AMOUNT FROM COMMAND-LINE
    ACCEPT TXN-DEST-ACCOUNT FROM COMMAND-LINE
    ACCEPT TXN-CHANNEL FROM COMMAND-LINE
    
    *> Generate transaction ID
    COMPUTE TXN-ID = FUNCTION RANDOM * 999999999999999999
    MOVE FUNCTION CURRENT-DATE TO TXN-TIMESTAMP
    
    *> Route to appropriate transaction handler
    EVALUATE TXN-TYPE
        WHEN "DEPOSIT"
            PERFORM PROCESS-DEPOSIT
        WHEN "WITHDRAWAL"
            PERFORM PROCESS-WITHDRAWAL
        WHEN "TRANSFER"
            PERFORM PROCESS-TRANSFER
        WHEN "PAYMENT"
            PERFORM PROCESS-PAYMENT
        WHEN "ATM-WITHDRAW"
            PERFORM PROCESS-ATM-WITHDRAWAL
        WHEN "WIRE-TRANSFER"
            PERFORM PROCESS-WIRE-TRANSFER
        WHEN OTHER
            MOVE 9001 TO TXN-RESULT-CODE
            MOVE "INVALID TRANSACTION TYPE" TO TXN-MESSAGE
            MOVE "REJECTED" TO TXN-STATUS
    END-EVALUATE
    
    PERFORM DISPLAY-TRANSACTION-RESULT
    STOP RUN.

PROCESS-DEPOSIT.
    *> Business Rule 1: Validate deposit amount
    IF TXN-AMOUNT < MIN-TXN-AMOUNT
        MOVE 4001 TO TXN-RESULT-CODE
        MOVE "DEPOSIT AMOUNT TOO SMALL" TO TXN-MESSAGE
        MOVE "REJECTED" TO TXN-STATUS
        GO TO END-DEPOSIT
    END-IF
    
    IF TXN-AMOUNT > MAX-TXN-AMOUNT
        MOVE 4002 TO TXN-RESULT-CODE
        MOVE "DEPOSIT EXCEEDS MAXIMUM LIMIT" TO TXN-MESSAGE
        MOVE "PENDING-REVIEW" TO TXN-STATUS
        GO TO END-DEPOSIT
    END-IF
    
    *> Validate account
    PERFORM LOAD-ACCOUNT-INFO
    
    IF TXN-RESULT-CODE NOT = 0000
        GO TO END-DEPOSIT
    END-IF
    
    IF ACC-STATUS = "CLOSED"
        MOVE 4003 TO TXN-RESULT-CODE
        MOVE "CANNOT DEPOSIT TO CLOSED ACCOUNT" TO TXN-MESSAGE
        MOVE "REJECTED" TO TXN-STATUS
        GO TO END-DEPOSIT
    END-IF
    
    IF ACC-STATUS = "FROZEN"
        MOVE 4004 TO TXN-RESULT-CODE
        MOVE "ACCOUNT IS FROZEN" TO TXN-MESSAGE
        MOVE "REJECTED" TO TXN-STATUS
        GO TO END-DEPOSIT
    END-IF
    
    *> Business Rule 2: Check deposit holds
    IF TXN-CHANNEL = "ATM" OR TXN-CHANNEL = "MOBILE"
        IF TXN-AMOUNT > 5000
            *> Large deposits have 2-day hold
            MOVE "POSTED-HOLD" TO TXN-STATUS
        ELSE
            MOVE "POSTED" TO TXN-STATUS
        END-IF
    ELSE
        *> Branch deposits available immediately
        MOVE "POSTED" TO TXN-STATUS
    END-IF
    
    *> Update balance
    COMPUTE WS-BALANCE-AFTER = ACC-BALANCE + TXN-AMOUNT
    MOVE WS-BALANCE-AFTER TO TXN-NEW-BALANCE
    
    MOVE 0000 TO TXN-RESULT-CODE
    MOVE "DEPOSIT PROCESSED SUCCESSFULLY" TO TXN-MESSAGE.
    
END-DEPOSIT.
    EXIT.

PROCESS-WITHDRAWAL.
    *> Validate amount
    IF TXN-AMOUNT < MIN-TXN-AMOUNT
        MOVE 4005 TO TXN-RESULT-CODE
        MOVE "WITHDRAWAL AMOUNT TOO SMALL" TO TXN-MESSAGE
        MOVE "REJECTED" TO TXN-STATUS
        GO TO END-WITHDRAWAL
    END-IF
    
    *> Load account
    PERFORM LOAD-ACCOUNT-INFO
    
    IF TXN-RESULT-CODE NOT = 0000
        GO TO END-WITHDRAWAL
    END-IF
    
    *> Business Rule 3: Check daily limits
    COMPUTE WS-FINAL-AMOUNT = ACC-DAILY-USED + TXN-AMOUNT
    
    IF WS-FINAL-AMOUNT > MAX-DAILY-WITHDRAWAL
        MOVE 4006 TO TXN-RESULT-CODE
        MOVE "DAILY WITHDRAWAL LIMIT EXCEEDED" TO TXN-MESSAGE
        MOVE "REJECTED" TO TXN-STATUS
        GO TO END-WITHDRAWAL
    END-IF
    
    *> Business Rule 4: Check sufficient funds
    IF TXN-AMOUNT > ACC-AVAILABLE
        MOVE 4007 TO TXN-RESULT-CODE
        MOVE "INSUFFICIENT FUNDS" TO TXN-MESSAGE
        MOVE "REJECTED" TO TXN-STATUS
        GO TO END-WITHDRAWAL
    END-IF
    
    *> Business Rule 5: Fraud detection (call external fraud system)
    CALL 'FRAUD-DETECTION' USING TXN-STREAM-RECORD FRAUD-SCORE
    
    IF FRAUD-SCORE > FRAUD-THRESHOLD
        MOVE 4008 TO TXN-RESULT-CODE
        MOVE "TRANSACTION FLAGGED FOR FRAUD REVIEW" TO TXN-MESSAGE
        MOVE "PENDING-REVIEW" TO TXN-STATUS
        GO TO END-WITHDRAWAL
    END-IF
    
    *> Process withdrawal
    COMPUTE WS-BALANCE-AFTER = ACC-BALANCE - TXN-AMOUNT
    MOVE WS-BALANCE-AFTER TO TXN-NEW-BALANCE
    
    MOVE 0000 TO TXN-RESULT-CODE
    MOVE "WITHDRAWAL PROCESSED SUCCESSFULLY" TO TXN-MESSAGE
    MOVE "POSTED" TO TXN-STATUS.
    
END-WITHDRAWAL.
    EXIT.

PROCESS-TRANSFER.
    *> Business Rule 6: Validate transfer amount
    IF TXN-AMOUNT < MIN-TXN-AMOUNT
        MOVE 4009 TO TXN-RESULT-CODE
        MOVE "TRANSFER AMOUNT TOO SMALL" TO TXN-MESSAGE
        MOVE "REJECTED" TO TXN-STATUS
        GO TO END-TRANSFER
    END-IF
    
    *> Business Rule 7: Check daily transfer limit
    PERFORM LOAD-ACCOUNT-INFO
    
    IF TXN-RESULT-CODE NOT = 0000
        GO TO END-TRANSFER
    END-IF
    
    COMPUTE WS-FINAL-AMOUNT = ACC-DAILY-USED + TXN-AMOUNT
    
    IF WS-FINAL-AMOUNT > MAX-DAILY-TRANSFER
        MOVE 4010 TO TXN-RESULT-CODE
        MOVE "DAILY TRANSFER LIMIT EXCEEDED" TO TXN-MESSAGE
        MOVE "REJECTED" TO TXN-STATUS
        GO TO END-TRANSFER
    END-IF
    
    *> Business Rule 8: Validate destination account
    IF TXN-DEST-ACCOUNT = TXN-ACCOUNT
        MOVE 4011 TO TXN-RESULT-CODE
        MOVE "CANNOT TRANSFER TO SAME ACCOUNT" TO TXN-MESSAGE
        MOVE "REJECTED" TO TXN-STATUS
        GO TO END-TRANSFER
    END-IF
    
    *> Check source funds
    IF TXN-AMOUNT > ACC-AVAILABLE
        MOVE 4012 TO TXN-RESULT-CODE
        MOVE "INSUFFICIENT FUNDS FOR TRANSFER" TO TXN-MESSAGE
        MOVE "REJECTED" TO TXN-STATUS
        GO TO END-TRANSFER
    END-IF
    
    *> Process transfer
    COMPUTE WS-BALANCE-AFTER = ACC-BALANCE - TXN-AMOUNT
    MOVE WS-BALANCE-AFTER TO TXN-NEW-BALANCE
    
    MOVE 0000 TO TXN-RESULT-CODE
    MOVE "TRANSFER PROCESSED SUCCESSFULLY" TO TXN-MESSAGE
    MOVE "POSTED" TO TXN-STATUS.
    
END-TRANSFER.
    EXIT.

PROCESS-PAYMENT.
    *> Business Rule 9: Payment processing (delegates to payment system)
    CALL 'PAYMENT-PROCESSING' USING TRANSACTION-INPUT TRANSACTION-OUTPUT
    
    IF TXN-AMOUNT < MIN-TXN-AMOUNT
        MOVE 4013 TO TXN-RESULT-CODE
        MOVE "PAYMENT AMOUNT TOO SMALL" TO TXN-MESSAGE
        MOVE "REJECTED" TO TXN-STATUS
        GO TO END-PAYMENT
    END-IF
    
    PERFORM LOAD-ACCOUNT-INFO
    
    IF TXN-RESULT-CODE NOT = 0000
        GO TO END-PAYMENT
    END-IF
    
    *> Check funds
    IF TXN-AMOUNT > ACC-AVAILABLE
        *> Business Rule 10: Overdraft handling
        IF ACC-TYPE = "CHECKING"
            *> Apply overdraft fee
            MOVE OVERDRAFT-FEE TO WS-FEES-CHARGED
            COMPUTE WS-FINAL-AMOUNT = TXN-AMOUNT + WS-FEES-CHARGED
            
            MOVE 2001 TO TXN-RESULT-CODE
            MOVE "PAYMENT PROCESSED WITH OVERDRAFT FEE" 
                TO TXN-MESSAGE
            MOVE "POSTED" TO TXN-STATUS
        ELSE
            MOVE 4014 TO TXN-RESULT-CODE
            MOVE "INSUFFICIENT FUNDS FOR PAYMENT" TO TXN-MESSAGE
            MOVE "REJECTED" TO TXN-STATUS
            GO TO END-PAYMENT
        END-IF
    ELSE
        MOVE TXN-AMOUNT TO WS-FINAL-AMOUNT
        MOVE ZERO TO WS-FEES-CHARGED
        MOVE 0000 TO TXN-RESULT-CODE
        MOVE "PAYMENT PROCESSED SUCCESSFULLY" TO TXN-MESSAGE
        MOVE "POSTED" TO TXN-STATUS
    END-IF
    
    COMPUTE WS-BALANCE-AFTER = ACC-BALANCE - WS-FINAL-AMOUNT
    MOVE WS-BALANCE-AFTER TO TXN-NEW-BALANCE.
    
END-PAYMENT.
    EXIT.

PROCESS-ATM-WITHDRAWAL.
    *> Business Rule 11: ATM-specific rules
    IF TXN-AMOUNT < MIN-TXN-AMOUNT
        MOVE 4015 TO TXN-RESULT-CODE
        MOVE "ATM AMOUNT TOO SMALL" TO TXN-MESSAGE
        MOVE "REJECTED" TO TXN-STATUS
        GO TO END-ATM
    END-IF
    
    *> ATM daily limit (lower than branch)
    IF TXN-AMOUNT > 1000
        MOVE 4016 TO TXN-RESULT-CODE
        MOVE "ATM TRANSACTION LIMIT EXCEEDED" TO TXN-MESSAGE
        MOVE "REJECTED" TO TXN-STATUS
        GO TO END-ATM
    END-IF
    
    PERFORM LOAD-ACCOUNT-INFO
    
    IF TXN-RESULT-CODE NOT = 0000
        GO TO END-ATM
    END-IF
    
    *> Business Rule 12: External ATM fees
    IF TXN-CHANNEL = "EXTERNAL-ATM"
        MOVE ATM-FEE-EXTERNAL TO WS-FEES-CHARGED
        COMPUTE WS-FINAL-AMOUNT = TXN-AMOUNT + WS-FEES-CHARGED
    ELSE
        MOVE ZERO TO WS-FEES-CHARGED
        MOVE TXN-AMOUNT TO WS-FINAL-AMOUNT
    END-IF
    
    IF WS-FINAL-AMOUNT > ACC-AVAILABLE
        MOVE 4017 TO TXN-RESULT-CODE
        MOVE "INSUFFICIENT FUNDS (INCLUDING FEES)" TO TXN-MESSAGE
        MOVE "REJECTED" TO TXN-STATUS
        GO TO END-ATM
    END-IF
    
    COMPUTE WS-BALANCE-AFTER = ACC-BALANCE - WS-FINAL-AMOUNT
    MOVE WS-BALANCE-AFTER TO TXN-NEW-BALANCE
    
    MOVE 0000 TO TXN-RESULT-CODE
    MOVE "ATM WITHDRAWAL SUCCESSFUL" TO TXN-MESSAGE
    MOVE "POSTED" TO TXN-STATUS.
    
END-ATM.
    EXIT.

PROCESS-WIRE-TRANSFER.
    *> Business Rule 13: Wire transfer validation
    IF TXN-AMOUNT < 100
        MOVE 4018 TO TXN-RESULT-CODE
        MOVE "WIRE MINIMUM IS $100" TO TXN-MESSAGE
        MOVE "REJECTED" TO TXN-STATUS
        GO TO END-WIRE
    END-IF
    
    PERFORM LOAD-ACCOUNT-INFO
    
    IF TXN-RESULT-CODE NOT = 0000
        GO TO END-WIRE
    END-IF
    
    *> Business Rule 14: Wire fees
    IF TXN-CHANNEL = "INTERNATIONAL"
        MOVE WIRE-FEE-INTERNATIONAL TO WS-FEES-CHARGED
    ELSE
        MOVE WIRE-FEE-DOMESTIC TO WS-FEES-CHARGED
    END-IF
    
    COMPUTE WS-FINAL-AMOUNT = TXN-AMOUNT + WS-FEES-CHARGED
    
    IF WS-FINAL-AMOUNT > ACC-AVAILABLE
        MOVE 4019 TO TXN-RESULT-CODE
        MOVE "INSUFFICIENT FUNDS FOR WIRE" TO TXN-MESSAGE
        MOVE "REJECTED" TO TXN-STATUS
        GO TO END-WIRE
    END-IF
    
    *> Business Rule 15: Large wire approval
    IF TXN-AMOUNT > 25000
        MOVE 2002 TO TXN-RESULT-CODE
        MOVE "WIRE PENDING COMPLIANCE REVIEW" TO TXN-MESSAGE
        MOVE "PENDING-REVIEW" TO TXN-STATUS
    ELSE
        COMPUTE WS-BALANCE-AFTER = ACC-BALANCE - WS-FINAL-AMOUNT
        MOVE WS-BALANCE-AFTER TO TXN-NEW-BALANCE
        
        MOVE 0000 TO TXN-RESULT-CODE
        MOVE "WIRE TRANSFER INITIATED" TO TXN-MESSAGE
        MOVE "POSTED" TO TXN-STATUS
    END-IF.
    
END-WIRE.
    EXIT.

LOAD-ACCOUNT-INFO.
    *> Call account management system to load account details
    CALL 'ACCOUNT-MANAGEMENT' USING TXN-ACCOUNT ACCOUNT-INFO
    
    *> Simulate account lookup (in real system, read from database)
    MOVE TXN-ACCOUNT TO ACC-NUMBER
    MOVE "CHECKING" TO ACC-TYPE
    MOVE "ACTIVE" TO ACC-STATUS
    MOVE 15000.00 TO ACC-BALANCE
    MOVE 14500.00 TO ACC-AVAILABLE
    MOVE 500.00 TO ACC-HOLD
    MOVE 1200.00 TO ACC-DAILY-USED
    
    MOVE 0000 TO TXN-RESULT-CODE.

CHECK-FRAUD-RISK.
    *> Simplified fraud scoring
    COMPUTE FRAUD-SCORE = (TXN-AMOUNT / 1000) * 10
    
    IF FRAUD-SCORE > 100
        MOVE 100 TO FRAUD-SCORE
    END-IF.

DISPLAY-TRANSACTION-RESULT.
    DISPLAY "TRANSACTION_ID=" TXN-ID
    DISPLAY "STATUS=" TXN-STATUS
    DISPLAY "RESULT_CODE=" TXN-RESULT-CODE
    DISPLAY "MESSAGE=" TXN-MESSAGE
    DISPLAY "NEW_BALANCE=" TXN-NEW-BALANCE
    DISPLAY "FEES_CHARGED=" WS-FEES-CHARGED
    DISPLAY "TIMESTAMP=" TXN-TIMESTAMP.

