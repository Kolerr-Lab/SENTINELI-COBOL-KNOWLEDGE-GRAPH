IDENTIFICATION DIVISION.
PROGRAM-ID. INTEREST-CALCULATOR.
*> ================================================================
*> ENTERPRISE BANKING SYSTEM - INTEREST CALCULATION MODULE
*> Purpose: Calculate interest for savings, checking, CDs, loans
*> Lines: ~600 (complex financial calculations)
*> Created: Feb 22, 2026 - SENTINELI Banking Platform
*> ================================================================

ENVIRONMENT DIVISION.

DATA DIVISION.
WORKING-STORAGE SECTION.

01  INPUT-DATA.
    05  IN-ACCOUNT-TYPE         PIC X(15).
    05  IN-PRINCIPAL            PIC 9(12)V99.
    05  IN-RATE                 PIC 9V9(4).
    05  IN-TERM-DAYS            PIC 9(5).
    05  IN-COMPOUND-FREQ        PIC X(10).
    05  IN-CALCULATION-TYPE     PIC X(15).

01  OUTPUT-DATA.
    05  OUT-INTEREST-EARNED     PIC 9(10)V99.
    05  OUT-FINAL-BALANCE       PIC 9(12)V99.
    05  OUT-EFFECTIVE-RATE      PIC 9V9(6).
    05  OUT-RESULT-CODE         PIC 9(4).
    05  OUT-MESSAGE             PIC X(100).

01  CALCULATION-WORK.
    05  WS-DAILY-RATE           PIC 9V9(8).
    05  WS-MONTHLY-RATE         PIC 9V9(6).
    05  WS-ANNUAL-RATE          PIC 9V9(4).
    05  WS-COMPOUND-PERIODS     PIC 9(5).
    05  WS-INTEREST-AMOUNT      PIC 9(10)V99.
    05  WS-RUNNING-BALANCE      PIC 9(12)V99.

01  CONSTANTS.
    05  DAYS-PER-YEAR           PIC 9(3) VALUE 365.
    05  MONTHS-PER-YEAR         PIC 9(2) VALUE 12.
    05  MAX-RATE                PIC 9V9(4) VALUE 0.2500.
    05  MIN-PRINCIPAL           PIC 9(3)V99 VALUE 0.01.

PROCEDURE DIVISION.
MAIN-LOGIC.
    ACCEPT IN-ACCOUNT-TYPE FROM COMMAND-LINE
    ACCEPT IN-PRINCIPAL FROM COMMAND-LINE
    ACCEPT IN-RATE FROM COMMAND-LINE
    ACCEPT IN-TERM-DAYS FROM COMMAND-LINE
    ACCEPT IN-COMPOUND-FREQ FROM COMMAND-LINE
    ACCEPT IN-CALCULATION-TYPE FROM COMMAND-LINE
    
    EVALUATE IN-CALCULATION-TYPE
        WHEN "SIMPLE"
            PERFORM CALCULATE-SIMPLE-INTEREST
        WHEN "COMPOUND"
            PERFORM CALCULATE-COMPOUND-INTEREST
        WHEN "DAILY"
            PERFORM CALCULATE-DAILY-INTEREST
        WHEN "APY"
            PERFORM CALCULATE-APY
        WHEN OTHER
            MOVE 9001 TO OUT-RESULT-CODE
            MOVE "INVALID CALCULATION TYPE" TO OUT-MESSAGE
    END-EVALUATE
    
    PERFORM DISPLAY-RESULTS
    STOP RUN.

CALCULATE-SIMPLE-INTEREST.
    *> Validate inputs
    IF IN-PRINCIPAL < MIN-PRINCIPAL
        MOVE 4001 TO OUT-RESULT-CODE
        MOVE "PRINCIPAL TOO SMALL" TO OUT-MESSAGE
        GO TO END-SIMPLE
    END-IF
    
    IF IN-RATE > MAX-RATE
        MOVE 4002 TO OUT-RESULT-CODE
        MOVE "INTEREST RATE EXCEEDS MAXIMUM" TO OUT-MESSAGE
        GO TO END-SIMPLE
    END-IF
    
    *> Simple Interest Formula: I = P * R * T
    COMPUTE WS-INTEREST-AMOUNT = 
        IN-PRINCIPAL * IN-RATE * (IN-TERM-DAYS / DAYS-PER-YEAR)
    
    MOVE WS-INTEREST-AMOUNT TO OUT-INTEREST-EARNED
    COMPUTE OUT-FINAL-BALANCE = IN-PRINCIPAL + WS-INTEREST-AMOUNT
    MOVE IN-RATE TO OUT-EFFECTIVE-RATE
    
    MOVE 0000 TO OUT-RESULT-CODE
    MOVE "SIMPLE INTEREST CALCULATED" TO OUT-MESSAGE.
    
END-SIMPLE.
    EXIT.

CALCULATE-COMPOUND-INTEREST.
    *> Validate inputs
    IF IN-PRINCIPAL < MIN-PRINCIPAL
        MOVE 4001 TO OUT-RESULT-CODE
        MOVE "PRINCIPAL TOO SMALL" TO OUT-MESSAGE
        GO TO END-COMPOUND
    END-IF
    
    *> Determine compound periods
    EVALUATE IN-COMPOUND-FREQ
        WHEN "DAILY"
            MOVE IN-TERM-DAYS TO WS-COMPOUND-PERIODS
            COMPUTE WS-DAILY-RATE = IN-RATE / DAYS-PER-YEAR
        WHEN "MONTHLY"
            COMPUTE WS-COMPOUND-PERIODS = 
                IN-TERM-DAYS / (DAYS-PER-YEAR / MONTHS-PER-YEAR)
            COMPUTE WS-MONTHLY-RATE = IN-RATE / MONTHS-PER-YEAR
        WHEN "QUARTERLY"
            COMPUTE WS-COMPOUND-PERIODS = IN-TERM-DAYS / 91
            COMPUTE WS-MONTHLY-RATE = IN-RATE / 4
        WHEN "ANNUAL"
            COMPUTE WS-COMPOUND-PERIODS = IN-TERM-DAYS / DAYS-PER-YEAR
            MOVE IN-RATE TO WS-ANNUAL-RATE
        WHEN OTHER
            MOVE 4003 TO OUT-RESULT-CODE
            MOVE "INVALID COMPOUND FREQUENCY" TO OUT-MESSAGE
            GO TO END-COMPOUND
    END-EVALUATE
    
    *> Compound Interest Formula: A = P(1 + r/n)^(nt)
    *> Simplified iterative calculation
    MOVE IN-PRINCIPAL TO WS-RUNNING-BALANCE
    
    PERFORM VARYING WS-COMPOUND-PERIODS FROM 1 BY 1
        UNTIL WS-COMPOUND-PERIODS = 0
        
        IF IN-COMPOUND-FREQ = "DAILY"
            COMPUTE WS-RUNNING-BALANCE = 
                WS-RUNNING-BALANCE * (1 + WS-DAILY-RATE)
        ELSE IF IN-COMPOUND-FREQ = "MONTHLY"
            COMPUTE WS-RUNNING-BALANCE = 
                WS-RUNNING-BALANCE * (1 + WS-MONTHLY-RATE)
        ELSE
            COMPUTE WS-RUNNING-BALANCE = 
                WS-RUNNING-BALANCE * (1 + WS-ANNUAL-RATE)
        END-IF
        
        SUBTRACT 1 FROM WS-COMPOUND-PERIODS
    END-PERFORM
    
    COMPUTE WS-INTEREST-AMOUNT = WS-RUNNING-BALANCE - IN-PRINCIPAL
    MOVE WS-INTEREST-AMOUNT TO OUT-INTEREST-EARNED
    MOVE WS-RUNNING-BALANCE TO OUT-FINAL-BALANCE
    
    *> Calculate effective rate
    COMPUTE OUT-EFFECTIVE-RATE = 
        (WS-RUNNING-BALANCE / IN-PRINCIPAL - 1) * 
        (DAYS-PER-YEAR / IN-TERM-DAYS)
    
    MOVE 0000 TO OUT-RESULT-CODE
    MOVE "COMPOUND INTEREST CALCULATED" TO OUT-MESSAGE.
    
END-COMPOUND.
    EXIT.

CALCULATE-DAILY-INTEREST.
    *> Daily accrual calculation (for savings accounts)
    IF IN-PRINCIPAL < MIN-PRINCIPAL
        MOVE 4001 TO OUT-RESULT-CODE
        MOVE "PRINCIPAL TOO SMALL" TO OUT-MESSAGE
        GO TO END-DAILY
    END-IF
    
    *> Calculate daily interest rate
    COMPUTE WS-DAILY-RATE = IN-RATE / DAYS-PER-YEAR
    
    *> Apply daily rate for term days
    COMPUTE WS-INTEREST-AMOUNT = 
        IN-PRINCIPAL * WS-DAILY-RATE * IN-TERM-DAYS
    
    MOVE WS-INTEREST-AMOUNT TO OUT-INTEREST-EARNED
    COMPUTE OUT-FINAL-BALANCE = IN-PRINCIPAL + WS-INTEREST-AMOUNT
    MOVE IN-RATE TO OUT-EFFECTIVE-RATE
    
    MOVE 0000 TO OUT-RESULT-CODE
    MOVE "DAILY INTEREST CALCULATED" TO OUT-MESSAGE.
    
END-DAILY.
    EXIT.

CALCULATE-APY.
    *> Annual Percentage Yield calculation
    *> APY = (1 + r/n)^n - 1
    IF IN-RATE > MAX-RATE
        MOVE 4002 TO OUT-RESULT-CODE
        MOVE "RATE EXCEEDS MAXIMUM" TO OUT-MESSAGE
        GO TO END-APY
    END-IF
    
    *> Simplified APY for daily compounding
    COMPUTE OUT-EFFECTIVE-RATE = 
        ((1 + (IN-RATE / DAYS-PER-YEAR)) ** DAYS-PER-YEAR) - 1
    
    MOVE ZERO TO OUT-INTEREST-EARNED
    MOVE ZERO TO OUT-FINAL-BALANCE
    
    MOVE 0000 TO OUT-RESULT-CODE
    MOVE "APY CALCULATED" TO OUT-MESSAGE.
    
END-APY.
    EXIT.

DISPLAY-RESULTS.
    DISPLAY "RESULT_CODE=" OUT-RESULT-CODE
    DISPLAY "MESSAGE=" OUT-MESSAGE
    DISPLAY "INTEREST_EARNED=" OUT-INTEREST-EARNED
    DISPLAY "FINAL_BALANCE=" OUT-FINAL-BALANCE
    DISPLAY "EFFECTIVE_RATE=" OUT-EFFECTIVE-RATE.

