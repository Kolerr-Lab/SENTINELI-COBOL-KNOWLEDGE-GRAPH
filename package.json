{
    "name": "sentineli",
    "version": "1.0.0",
    "description": "Sentineli - Neuro-Symbolic Mainframe Modernization Platform",
    "main": "src/bridge/server.js",
    "author": "Ricky Anh Nguyen <ricky@orchesity.com> (OrchesityAI & Kolerr Lab)",
    "license": "BUSL-1.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/Kolerr-Lab/sentineli.git"
    },
    "keywords": [
        "cobol",
        "mainframe",
        "legacy-modernization",
        "ai",
        "knowledge-graph",
        "gnucobol",
        "neuro-symbolic"
    ],
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    },
    "scripts": {
        "setup": "node setup.js",
        "start": "node src/bridge/server.js",
        "start:pm2": "pm2 start ecosystem.config.js",
        "stop:pm2": "pm2 stop ecosystem.config.js",
        "restart:pm2": "pm2 restart ecosystem.config.js",
        "logs:pm2": "pm2 logs",
        "monitor:pm2": "pm2 monit",
        "dev": "nodemon src/bridge/server.js",
        "compile": "node scripts/compile-cobol.js",
        "prestart": "npm run compile && npm run db:migrate",
        "predev": "npm run compile && npm run db:migrate",
        "test": "jest --coverage",
        "test:unit": "jest tests/unit --coverage",
        "test:integration": "jest tests/integration",
        "test:performance": "node tests/performance/hft_flood.js",
        "test:watch": "jest --watch",
        "test:ci": "jest --ci --coverage --maxWorkers=2",
        "lint": "eslint src tests --ext .js",
        "lint:fix": "eslint src tests --ext .js --fix",
        "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
        "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
        "audit": "npm audit --audit-level=moderate",
        "audit:fix": "npm audit fix",
        "security:scan": "npm audit && docker scan sentineli:latest || true",
        "docker:build": "docker-compose build",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:logs": "docker-compose logs -f",
        "db:migrate": "node scripts/migrate.js",
        "db:seed": "node scripts/seed.js",
        "prepare": "husky install || true"
    },
    "dependencies": {
        "axios": "^1.7.9",
        "bcrypt": "^6.0.0",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "express-slow-down": "^3.1.0",
        "helmet": "^8.0.0",
        "hpp": "^0.2.3",
        "joi": "^17.13.3",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "openai": "^4.77.3",
        "pg": "^8.14.0",
        "pino": "^9.6.0",
        "pino-pretty": "^13.0.0",
        "pm2": "^7.0.1",
        "prom-client": "^15.1.3",
        "rate-limit-redis": "^4.3.1",
        "redis": "^4.7.0",
        "uuid": "^11.0.5",
        "xss": "^1.0.15",
        "z3-solver": "^4.16.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "eslint": "^8.57.1",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^27.9.0",
        "eslint-plugin-security": "^3.0.1",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "lint-staged": "^15.2.11",
        "nodemon": "^3.1.9",
        "prettier": "^3.4.2",
        "supertest": "^7.0.0"
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "overrides": {
        "tar": "^7.5.10",
        "minimatch": "^10.2.2"
    }
}
