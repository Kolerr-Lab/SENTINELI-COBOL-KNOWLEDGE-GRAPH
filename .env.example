# =============================================================================
# Orchesity Neural-Core Configuration
# =============================================================================

# --- 1. AI Configuration (REQUIRED for analysis features) ---
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# --- 2. Application Configuration ---
# Server port (default: 3050)
PORT=3050

# Environment: development, production, test
NODE_ENV=development

# Log level: debug, info, warn, error
LOG_LEVEL=info

# --- 3. Security Configuration ---
# JWT secret for authentication (CHANGE IN PRODUCTION!)
# Generate with: openssl rand -base64 64
JWT_SECRET=development-secret-change-in-production-to-something-secure

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3050

# API Keys for testing/development (comma-separated)
# Generate strong keys for production: openssl rand -hex 32
# SECURITY: Rotate keys regularly. Send via X-API-Key header for authentication.
# Used by Rust gateway and Node.js backend for request validation
API_KEYS=demo-api-key-sentineli-2026,test-key-development-only

# --- 4. Database Configuration ---
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://admin:secure_pass@localhost:5432/kg_cobol_db

# Production database (use with SSL)
# DATABASE_URL=postgres://user:password@prod-host:5432/dbname?sslmode=require

# --- 5. Redis Configuration ---
# Redis connection URL
REDIS_URL=redis://localhost:6379

# Redis with authentication
# REDIS_URL=redis://:password@localhost:6379

# --- 6. COBOL Configuration (Optional) ---
# Path to COBOL compiler (defaults to 'cobc')
# COBOL_COMPILER=cobc

# Path to compiled COBOL executables (defaults to './bin')
# COBOL_BIN_DIR=./bin

# Path to COBOL source files (defaults to './src/cobol')
# COBOL_SRC_DIR=./src/cobol

# --- 7. Rate Limiting ---
# Requests per minute per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Execution endpoint rate limit
EXECUTION_RATE_LIMIT_MAX=30

# --- 8. Monitoring (Optional) ---
# Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn-here

# Application name for monitoring
APP_NAME=orchesity-neural-core

# --- 9. Performance Tuning ---
# Database connection pool size
DB_POOL_SIZE=20

# Redis connection retry attempts
REDIS_MAX_RETRIES=10

# COBOL execution timeout (milliseconds)
COBOL_EXECUTION_TIMEOUT=30000

# =============================================================================
# Docker-specific Configuration
# =============================================================================
# When running in Docker Compose, use these:

# DATABASE_URL=postgres://admin:secure_pass@db:5432/kg_cobol_db
# REDIS_URL=redis://cache:6379

# =============================================================================
# Production Checklist
# =============================================================================
# Before deploying to production, ensure:
# [ ] JWT_SECRET is changed to a secure random value
# [ ] Database credentials are secure
# [ ] ALLOWED_ORIGINS is restricted to your domains
# [ ] NODE_ENV is set to 'production'
# [ ] LOG_LEVEL is 'info' or 'warn'
# [ ] SSL/TLS is enabled for database connections
# [ ] All secrets are managed via environment variables or secrets manager
