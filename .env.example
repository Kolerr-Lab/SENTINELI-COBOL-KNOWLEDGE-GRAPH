# --- 1. AI Configuration (REQUIRED) ---
# Your OpenAI API Key is needed for the Knowledge Graph extraction.
# Get one at: platform.openai.com
OPENAI_API_KEY=sk-put-your-key-here

# --- 2. Application Configuration ---
# The port the Node.js bridge will listen on (default: 3000)
PORT=3050

# Environment mode: 'development' (uses nodemon) or 'production'
NODE_ENV=development

# --- 3. Full Stack Dependencies ---
# Database Connection (internal docker user/pass)
DATABASE_URL=postgres://admin:secure_pass@db:5432/kg_cobol_db

# Redis Cache Connection
REDIS_URL=redis://cache:6379

# --- 4. Optional Paths (if not using Docker defaults) ---
# Path to compiled COBOL executables (relative to src/bridge/server.js)
# COBOL_BIN_DIR=../../bin

# Path to COBOL source code (relative to src/bridge/server.js)
# COBOL_SRC_DIR=../../src